#!/bin/bash

# Get the workspace name from the frontmost Cursor window title
WINDOW_TITLE=$(osascript -e '
tell application "System Events"
  tell process "Cursor"
    return title of front window
  end tell
end tell' 2>/dev/null)

# Title format: "filename — workspace" or just "workspace"
WORKSPACE_NAME=$(echo "$WINDOW_TITLE" | sed 's/.*— //')

# Look up the full path for that workspace name in Cursor's history
CURSOR_DIR=$(sqlite3 "$HOME/Library/Application Support/Cursor/User/globalStorage/state.vscdb" \
  "SELECT value FROM ItemTable WHERE key = 'history.recentlyOpenedPathsList'" 2>/dev/null \
  | python3 -c "
import sys, json, urllib.parse, os
target = sys.argv[1]
data = json.load(sys.stdin)
for e in data.get('entries', []):
    uri = e.get('folderUri') or e.get('fileUri', '')
    if uri.startswith('file://'):
        path = urllib.parse.unquote(uri[7:])
        if os.path.basename(path) == target:
            print(path)
            break
" "$WORKSPACE_NAME" 2>/dev/null)

if [ -z "$CURSOR_DIR" ] || [ ! -d "$CURSOR_DIR" ]; then
  CURSOR_DIR="${HERDR_PROJECT_ROOT:-$HOME/projects}"
fi

# Enter accepts the detected/default path, typing replaces it.
CURSOR_DIR=$(gum input --value "$CURSOR_DIR" --placeholder "project root" --header "Project root")
[ -z "$CURSOR_DIR" ] && exit 1

/Users/jordan.chase/.local/bin/herdr workspace create --focus --cwd "$CURSOR_DIR"
osascript -e 'tell application "System Events" to set frontmost of (first process whose name contains "herdr") to true' 2>/dev/null || true
