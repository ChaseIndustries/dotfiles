{
  "python.terminal.useEnvFile": true,
  "python.terminal.activateEnvironment": false,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "window.commandCenter": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.experimentalEditContextEnabled": true,
  "editor.minimap.enabled": true,
  "editor.formatOnSave": true,
  "workbench.activityBar.orientation": "vertical",
  "python.defaultInterpreterPath": "python3",
  "claudeCode.preferredLocation": "panel",
  "git.showCursorWorktrees": true,
  "git.autoRepositoryDetection": true,
  "diffEditor.codeLens": true,
  "git.openDiffOnClick": false,
  "githubPullRequests.quickDiff": true,
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.initialPermissionMode": "bypassPermissions",
  "eslint.useRealpaths": true,
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "terminal.integrated.tabs.location": "left",
  "git.autofetch": true,
  "git.confirmSync": false,
  "explorer.confirmDelete": false,
  "terminal.integrated.defaultProfile.osx": "herdr",
  "terminal.external.osxExec": "iterm",
  "githubPullRequests.defaultCreateOption": "createDraft",
  "githubPullRequests.defaultMergeMethod": "squash",
  "terminal.integrated.tabs.title": "${sequence}",
  "terminal.integrated.tabs.description": "${cwdFolder}",
  "git.blame.editorDecoration.enabled": true,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "quickPrompt.ai.autoGenerateTitle": false,
  "zenMode.centerLayout": false,
  "git.openRepositoryInParentFolders": "always",
  "workbench.settings.openDefaultKeybindings": true,
  "githubPullRequests.pullBranch": "never",
  "explorer.confirmDragAndDrop": false,
  "git-worktree-manager.worktreeCopyPatterns": [
    ".env",
    ".vscode/**",
    "*.local.*",
  ],
  "git-worktree-manager.worktreeCopyIgnores": [
    "**/dist/**",
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/Thumbs.db/**",
    "**/.DS_Store",
    ".worktrees",
  ],
  "claudeCode.enableNewConversationShortcut": true,
  "claudeCode.useTerminal": true,
  "claudeCode.useCtrlEnterToSend": true,
  "cursor.terminal.usePreviewBox": false,
  "terminal.integrated.profiles.osx": {
    "zsh": {
      "path": "zsh",
      "color": "terminal.ansiBlue",
      "icon": "terminal",
      "env": {
        "GIT_WRAPPER_CONTEXT": "cursor",
      },
      "args": ["-l"],
    },
    "JavaScript Debug Terminal": null,
    "bash": null,
    "herdr": {
      "path": "zsh",
      "args": ["-l", "-c", "exec herdr"],
      "env": {
        "GIT_WRAPPER_CONTEXT": "herdr",
      },
    },
  },
  "python-envs.terminal.showActivateButton": true,
  "python-envs.terminal.autoActivationType": "shellStartup",
  "git.ignoreMissingGitWarning": true,
  "git.path": "git",
  "git.terminalAuthentication": true,
  "biome.requireConfiguration": true,
  "window.autoDetectColorScheme": false,
  "githubPullRequests.notifications": "pullRequests",
  "githubPullRequests.pushBranch": "always",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "application.shellEnvironmentResolutionTimeout": 30,
  "typescript.tsdk": ".yarn/sdks/typescript/lib",
  "security.workspace.trust.untrustedFiles": "open",
  "cursor.composer.editorConversationDensity": "compact-ungrouped",
  "terminal.integrated.rightClickBehavior": "nothing",
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.confirmOnKill": "never",
}
